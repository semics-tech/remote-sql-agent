{
  "name": "remote-sql-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Centrally view, monitor and manage SQL Server Agent jobs across firewalled estates via outbound-only workers.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project protocol --project server --project worker --project dashboard",
    "test:integration": "vitest run --project integration",
    "proto:gen": "pnpm --filter @remote-sql-agent/protocol run proto:gen",
    "proto:check": "pnpm --filter @remote-sql-agent/protocol run proto:check",
    "db:generate": "pnpm --filter @remote-sql-agent/server run db:generate",
    "db:migrate": "pnpm --filter @remote-sql-agent/server run db:migrate",
    "dev:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f deploy/docker-compose.dev.yml down -v",
    "dev:seed": "tsx scripts/seed-sql.ts",
    "dev:server": "RSAGENT_GRPC_REQUIRE_TLS=false RSAGENT_BOOTSTRAP_ADMIN_PASSWORD=rsagent-dev pnpm --filter @remote-sql-agent/server dev",
    "dev:dashboard": "pnpm --filter @remote-sql-agent/dashboard dev",
    "dev:reset-admin": "pnpm --filter @remote-sql-agent/server run reset-dev-admin",
    "dev:worker": "pnpm --filter @remote-sql-agent/worker start ../../deploy/worker.dev.yaml",
    "dev:enrol": "pnpm --filter @remote-sql-agent/worker start enrol ../../deploy/worker.dev.yaml",
    "lint:fix": "eslint . --fix",
    "build:packages": "pnpm --filter @remote-sql-agent/protocol build && pnpm --filter @remote-sql-agent/worker bundle",
    "release:dry": "pnpm --filter @remote-sql-agent/protocol publish --dry-run --no-git-checks && pnpm --filter @remote-sql-agent/worker publish --dry-run --no-git-checks",
    "test:e2e": "pnpm --filter @remote-sql-agent/dashboard test:e2e"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8"
    },
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "argon2",
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "ts-proto": "^2.6.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semics-tech/remote-sql-agent.git"
  },
  "homepage": "https://github.com/semics-tech/remote-sql-agent#readme",
  "bugs": {
    "url": "https://github.com/semics-tech/remote-sql-agent/issues"
  },
  "keywords": [
    "sql-server",
    "sql-agent",
    "msdb",
    "dba",
    "job-monitoring",
    "estate-management"
  ],
  "author": "semics"
}
