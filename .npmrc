strict-peer-dependencies=false
auto-install-peers=true
# provenance is deliberately not set here.
#
# Published packages still carry a provenance attestation — trusted publishing
# generates one automatically from the OIDC token, so consumers can verify a
# package was built by this repository's release workflow. Requesting it
# through config as well adds nothing, and it breaks any publish run outside
# CI, including the one-time bootstrap publish a new package needs before a
# trusted publisher can be configured for it. See docs/releasing.md.
