# Copy to .env and edit before `docker compose up -d`.

# --- Required -----------------------------------------------------------------

# Pin this. `latest` means a `docker compose pull` months from now brings in
# whatever has been released since, at a moment you did not choose.
# Releases: https://github.com/semics-tech/remote-sql-agent/releases
RSAGENT_VERSION=0.1.1

# techsemics/remote-sql-agent (Docker Hub) by default. The same image is at
# ghcr.io/semics-tech/remote-sql-agent/control-plane with the same digest.
#RSAGENT_IMAGE=ghcr.io/semics-tech/remote-sql-agent/control-plane

# Must match the origin workers and browsers reach this control plane on.
# Use https in production: it is also what makes session cookies Secure.
RSAGENT_PUBLIC_URL=https://rsagent.corp.example.com

POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Directory containing server.crt and server.key for the worker hub.
RSAGENT_TLS_DIR=./tls

# Where workers should dial the hub, as host:port. Leave unset and it is derived
# as RSAGENT_PUBLIC_URL's host plus the hub's own port, which is right for this
# Compose file as shipped.
#
# Set it when that derivation is wrong: if you remap RSAGENT_GRPC_PORT below
# (that only changes the *host-side* published port, not the one the container
# binds or the one the dashboard prints), or if the hub reaches the outside
# world under a different name from the dashboard — a separate load balancer,
# or a container platform mapping ports.
#
# This string is copied into worker.yaml on every SQL host, so a wrong value
# does not fail loudly: workers retry forever and simply never appear.
#RSAGENT_HUB_ADVERTISED_ADDRESS=rsagent.corp.example.com:8443

# --- Dashboard sign-in --------------------------------------------------------

# local | entra | both
# "both" keeps a local break-glass admin usable if Entra is unreachable.
RSAGENT_AUTH_MODE=local

RSAGENT_BOOTSTRAP_ADMIN=admin
# Leave blank to have one generated and printed once to the log on first boot.
# There is deliberately no fixed default password.
RSAGENT_BOOTSTRAP_ADMIN_PASSWORD=

# Required when RSAGENT_AUTH_MODE includes entra. See docs/authentication.md
# for the app registration and app-role setup.
RSAGENT_ENTRA_TENANT_ID=
RSAGENT_ENTRA_CLIENT_ID=
RSAGENT_ENTRA_CLIENT_SECRET=

# --- Worker authentication ----------------------------------------------------

# token | mtls | entra, comma-separated. token is the simplest to operate.
RSAGENT_WORKER_AUTH_MODES=token

# --- HTTPS for the dashboard --------------------------------------------------

# Only used by the `tls` profile: docker compose --profile tls up -d
#
# Caddy gets and renews a certificate for this name automatically. Needs ports
# 80 and 443 reachable from the internet, and this name pointing here.
#
# Serve the dashboard over HTTPS in any deployment that will hold SQL logins:
# the browser encrypts credentials to the worker's public key, and it will not
# do that in an insecure context. Over plain HTTP the field disables itself.
#RSAGENT_DOMAIN=rsagent.corp.example.com

# Set to 127.0.0.1 when using the tls profile, so 8080 is reachable only through
# Caddy. Left open, the same dashboard is also served insecurely on a second
# origin — where credential onboarding does not work and nothing says why.
#RSAGENT_HTTP_BIND=127.0.0.1

# --- Reverse proxies ----------------------------------------------------------

# How many reverse proxies sit in front of the HTTP port. This decides where the
# client IP is read from, and that IP is what rate limiting counts against and
# what is recorded on every audit row.
#
# 0 ignores X-Forwarded-For and uses the connecting address — correct when the
# control plane is published directly, and the only value a caller cannot
# influence. Set 1 if you terminate TLS in front of it — including whenever you
# use the `tls` profile above, an ingress controller, or Container Apps.
#
# Never set this higher than the number of proxies you actually run: each extra
# hop is one entry of client-supplied header that gets believed.
RSAGENT_TRUSTED_PROXY_HOPS=0

# --- Audit export -------------------------------------------------------------

# The database always holds the audit trail. This forwards it as well.
# Any OTLP-compatible backend: Azure Monitor, Splunk, Datadog, Elastic, Loki.
RSAGENT_AUDIT_OTLP_ENABLED=false
RSAGENT_AUDIT_OTLP_ENDPOINT=http://otel-collector:4318/v1/logs
RSAGENT_AUDIT_OTLP_HEADERS=

# --- Trace export ---------------------------------------------------------------

# A span per API request and per worker command, start to finish (dispatch to
# result or expiry) — not the same signal as the audit log above, and not the
# same endpoint: most collectors that accept OTLP logs also accept OTLP
# traces, but never on the same path.
RSAGENT_TRACE_OTLP_ENABLED=false
RSAGENT_TRACE_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
RSAGENT_TRACE_OTLP_HEADERS=
# 1 = trace everything, which is the right default for this product's traffic
# (an operations team, not the public internet). Lower it on a large estate if
# the collector needs the volume capped.
RSAGENT_TRACE_SAMPLE_RATIO=1

# --- Behaviour ----------------------------------------------------------------

# Require a second person to approve job edits. Strongly recommended.
RSAGENT_REQUIRE_APPROVAL_JOB_WRITE=true

RSAGENT_HISTORY_RETENTION_DAYS=90
RSAGENT_LOG_LEVEL=info

# Host-side published ports only. The container always binds 8080 and 8443, and
# changing these does not change what the dashboard prints in install commands
# — set RSAGENT_HUB_ADVERTISED_ADDRESS above if you remap the hub.
RSAGENT_HTTP_PORT=8080
RSAGENT_GRPC_PORT=8443
