# Copy to .env and edit before `docker compose up -d`.

# --- Required -----------------------------------------------------------------

# Must match the origin workers and browsers reach this control plane on.
# Use https in production: it is also what makes session cookies Secure.
RSAGENT_PUBLIC_URL=https://rsagent.corp.example.com

POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Directory containing server.crt and server.key for the worker hub.
RSAGENT_TLS_DIR=./tls

# --- Dashboard sign-in --------------------------------------------------------

# local | entra | both
# "both" keeps a local break-glass admin usable if Entra is unreachable.
RSAGENT_AUTH_MODE=local

RSAGENT_BOOTSTRAP_ADMIN=admin
# Leave blank to have one generated and printed once to the log on first boot.
# There is deliberately no fixed default password.
RSAGENT_BOOTSTRAP_ADMIN_PASSWORD=

# Required when RSAGENT_AUTH_MODE includes entra. See docs/authentication.md
# for the app registration and app-role setup.
RSAGENT_ENTRA_TENANT_ID=
RSAGENT_ENTRA_CLIENT_ID=
RSAGENT_ENTRA_CLIENT_SECRET=

# --- Worker authentication ----------------------------------------------------

# token | mtls | entra, comma-separated. token is the simplest to operate.
RSAGENT_WORKER_AUTH_MODES=token

# --- Reverse proxies ----------------------------------------------------------

# How many reverse proxies sit in front of the HTTP port. This decides where the
# client IP is read from, and that IP is what rate limiting counts against and
# what is recorded on every audit row.
#
# 0 ignores X-Forwarded-For and uses the connecting address — correct when the
# control plane is published directly, and the only value a caller cannot
# influence. Set 1 if you terminate TLS in front of it (the `tls` Compose
# profile, an ingress controller, Container Apps).
#
# Never set this higher than the number of proxies you actually run: each extra
# hop is one entry of client-supplied header that gets believed.
RSAGENT_TRUSTED_PROXY_HOPS=0

# --- Audit export -------------------------------------------------------------

# The database always holds the audit trail. This forwards it as well.
# Any OTLP-compatible backend: Azure Monitor, Splunk, Datadog, Elastic, Loki.
RSAGENT_AUDIT_OTLP_ENABLED=false
RSAGENT_AUDIT_OTLP_ENDPOINT=http://otel-collector:4318/v1/logs
RSAGENT_AUDIT_OTLP_HEADERS=

# --- Behaviour ----------------------------------------------------------------

# Require a second person to approve job edits. Strongly recommended.
RSAGENT_REQUIRE_APPROVAL_JOB_WRITE=true

RSAGENT_HISTORY_RETENTION_DAYS=90
RSAGENT_LOG_LEVEL=info

RSAGENT_HTTP_PORT=8080
RSAGENT_GRPC_PORT=8443
