{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser target and DOM libs, overriding the base's Node ES2023 — every
    // other override below is here because it too differs from every other
    // package, not because the base doesn't already set it.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  // `test` and `e2e` were absent, so nothing typechecked them — the browser
  // tests are the only thing in this repository that renders a component, and
  // they were the one place a type error could not be caught.
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts"]
}
