{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["vite/client"]
  },
  // `test` and `e2e` were absent, so nothing typechecked them — the browser
  // tests are the only thing in this repository that renders a component, and
  // they were the one place a type error could not be caught.
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts"]
}
