{
  "name": "@remote-sql-agent/protocol",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "proto:gen": "tsx scripts/gen-proto.ts",
    "proto:check": "tsx scripts/gen-proto.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "description": "Shared contracts consumed by the worker, server and dashboard from source. Not published: see docs/faq.md.",
  "sideEffects": false
}
