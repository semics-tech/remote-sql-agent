{
  "name": "@rsagent/protocol",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "proto:gen": "tsx scripts/gen-proto.ts",
    "proto:check": "tsx scripts/gen-proto.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.12.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
